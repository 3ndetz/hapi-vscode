{
  "name": "hapi-chat",
  "displayName": "HAPI Chat",
  "description": "Full HAPI website chats in independent VS Code windows, saved hub profiles, grouped folders, automatic login and configurable proxy.",
  "version": "0.5.1",
  "icon": "media/icon.png",
  "publisher": "3ndetz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "hapi",
    "codex",
    "claude",
    "chat",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/3ndetz/hapi-vscode.git"
  },
  "homepage": "https://github.com/3ndetz/hapi-vscode#readme",
  "bugs": {
    "url": "https://github.com/3ndetz/hapi-vscode/issues"
  },
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onWebviewPanel:hapiChat.chat",
    "onView:hapiChat.conversation",
    "onWebviewPanel:hapiChat.website"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "configuration": {
      "title": "HAPI Chat",
      "properties": {
        "hapiChat.chatMode": {
          "type": "string",
          "enum": [
            "web",
            "custom"
          ],
          "enumDescriptions": [
            "Open the full HAPI website, in the sidebar by default.",
            "Use the extension's minimal native API chat panel."
          ],
          "default": "web",
          "scope": "application",
          "description": "Interface for opening HAPI chats. Existing tabs keep their current interface."
        },
        "hapiChat.webLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "browser"
          ],
          "default": "sidebar",
          "scope": "application",
          "description": "Open Web chats in the full-height HAPI right sidebar or in integrated-browser editor tabs. Sidebar uses the saved profile for automatic sign-in; browser tabs use normal website login."
        },
        "hapiChat.syncEditorTheme": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Pass VS Code's light/dark color scheme to sidebar websites. Keep HAPI Appearance set to System to follow the editor."
        },
        "hapiChat.useVSCodeProxy": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Use VS Code http.proxy/proxySupport/noProxy and environment proxies for all extension API and embedded website traffic, including streaming and WebSockets. Disable to connect directly. Loopback is always direct. Existing streams use their current route until reconnect or website reload. Each connection can override this HAPI switch using its Proxy selector or HAPI: Connection Proxy."
        }
      }
    },
    "commands": [
      {
        "command": "hapiChat.addConnection",
        "title": "HAPI: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "hapiChat.selectConnection",
        "title": "HAPI: Switch Connection",
        "icon": "$(plug)"
      },
      {
        "command": "hapiChat.editConnection",
        "title": "HAPI: Edit Connection"
      },
      {
        "command": "hapiChat.removeConnection",
        "title": "HAPI: Remove Connection"
      },
      {
        "command": "hapiChat.openChat",
        "title": "HAPI: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hapiChat.newChat",
        "title": "HAPI: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "hapiChat.refresh",
        "title": "HAPI: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "hapiChat.changeChatMode",
        "title": "HAPI: Change Chat Mode",
        "icon": "$(browser)"
      },
      {
        "command": "hapiChat.openHub",
        "title": "HAPI: Open Hub Website",
        "icon": "$(globe)"
      },
      {
        "command": "hapiChat.openBrowser",
        "title": "HAPI: Open in Integrated Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "hapiChat.showChats",
        "title": "HAPI: Show Chat List",
        "icon": "$(list-tree)"
      },
      {
        "command": "hapiChat.showChatPanel",
        "title": "HAPI: Show Right Chat Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hapiChat.copyLoginToken",
        "title": "HAPI: Copy Login Token"
      },
      {
        "command": "hapiChat.openChatBeside",
        "title": "HAPI: Open Chat Beside",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "hapiChat.newChatWindow",
        "title": "HAPI: New Chat Window",
        "icon": "$(new-window)"
      },
      {
        "command": "hapiChat.connectionProxy",
        "title": "HAPI: Connection Proxy",
        "icon": "$(globe)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hapiChat",
          "title": "HAPI Connections",
          "icon": "media/hapi.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "hapiChatConversations",
          "title": "HAPI Chats",
          "icon": "media/hapi.svg"
        }
      ]
    },
    "views": {
      "hapiChat": [
        {
          "id": "hapiChat.sessions",
          "name": "Connections and Folders"
        }
      ],
      "hapiChatConversations": [
        {
          "id": "hapiChat.conversation",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hapiChat.sessions",
        "contents": "Connect to a HAPI hub to open agent chats.\n[Add Connection](command:hapiChat.addConnection)",
        "when": "!hapiChat.hasConnections"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hapiChat.newChat",
          "when": "view == hapiChat.conversation",
          "group": "navigation@1"
        },
        {
          "command": "hapiChat.showChats",
          "when": "view == hapiChat.conversation",
          "group": "navigation@2"
        },
        {
          "command": "hapiChat.selectConnection",
          "when": "view == hapiChat.sessions",
          "group": "navigation@1"
        },
        {
          "command": "hapiChat.newChat",
          "when": "view == hapiChat.sessions",
          "group": "navigation@2"
        },
        {
          "command": "hapiChat.refresh",
          "when": "view == hapiChat.sessions",
          "group": "navigation@3"
        },
        {
          "command": "hapiChat.showChatPanel",
          "when": "view == hapiChat.sessions",
          "group": "navigation@4"
        },
        {
          "command": "hapiChat.addConnection",
          "when": "view == hapiChat.sessions",
          "group": "connections@1"
        },
        {
          "command": "hapiChat.changeChatMode",
          "when": "view == hapiChat.sessions",
          "group": "connections@2"
        },
        {
          "command": "hapiChat.openHub",
          "when": "view == hapiChat.sessions",
          "group": "connections@3"
        },
        {
          "command": "hapiChat.newChatWindow",
          "when": "view == hapiChat.conversation",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "hapiChat.newChat",
          "when": "view == hapiChat.sessions && viewItem == hapiFolder",
          "group": "inline@1"
        },
        {
          "command": "hapiChat.newChat",
          "when": "view == hapiChat.sessions && viewItem == hapiConnection",
          "group": "inline@1"
        },
        {
          "command": "hapiChat.editConnection",
          "when": "view == hapiChat.sessions && viewItem == hapiConnection",
          "group": "connection@1"
        },
        {
          "command": "hapiChat.openHub",
          "when": "view == hapiChat.sessions && viewItem == hapiConnection",
          "group": "connection@2"
        },
        {
          "command": "hapiChat.copyLoginToken",
          "when": "view == hapiChat.sessions && viewItem == hapiConnection",
          "group": "connection@3"
        },
        {
          "command": "hapiChat.removeConnection",
          "when": "view == hapiChat.sessions && viewItem == hapiConnection",
          "group": "connection@4"
        },
        {
          "command": "hapiChat.openChatBeside",
          "when": "view == hapiChat.sessions && viewItem == hapiSession",
          "group": "inline@1"
        },
        {
          "command": "hapiChat.newChatWindow",
          "when": "view == hapiChat.sessions && viewItem == hapiFolder",
          "group": "chat@1"
        },
        {
          "command": "hapiChat.connectionProxy",
          "when": "view == hapiChat.sessions && viewItem == hapiConnection",
          "group": "connection@2"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node scripts/check.js",
    "package": "vsce package",
    "test:host": "node scripts/test-host.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.2.0"
  },
  "dependencies": {
    "undici": "7.30.0"
  }
}
